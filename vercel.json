{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/internal/auto-confirm",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/v1/internal/overdue-check",
      "schedule": "0 17 * * *"
    }
  ]
}